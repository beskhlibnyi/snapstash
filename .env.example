# Required for Google sign-in
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Required for reading the shared Google Drive folder
GOOGLE_DRIVE_API_KEY=your_google_api_key_here
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# Recommended for local sessions; the app falls back to a development default if omitted
SESSION_SECRET=change_this_to_a_long_random_string

# Optional comma-separated Google email allowlist for /admin
ADMIN_EMAILS=you@example.com

# Optional; required only to run AI tagging from /admin
OPENAI_API_KEY=your_openai_api_key_here
TAGGING_MODEL=gpt-5.6-luna

# Optional seed for the deterministic global winner photo
WINNING_PHOTO_SEED=klyovault-prototype
